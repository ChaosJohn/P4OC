{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "manual",
  "lsp": true,
  "formatter": true,
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow",
      "**/*credential*": "deny",
      "**/*secret*": "deny",
      "**/*token*": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow"
    },
    "task": "ask",
    "question": "ask",
    "external_directory": "deny",
    "doom_loop": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "lsp": "allow",
    "skill": "allow",
    "demo_triage_*": "allow"
  },
  "mcp": {
    "demo_triage": {
      "type": "local",
      "command": [
        "node",
        "/opt/opencode/mcp/server.mjs"
      ],
      "enabled": true,
      "timeout": 5000
    }
  }
}
