# Copy this file to .env.demo, replace every demo password, then start with:
# docker compose --env-file .env.demo -f compose.demo.yml up --build
# .env.demo is ignored by git. Do not commit real passwords or API keys.
# The host ports bind to the LAN so a physical Android device can reach them.
# Use strong, unique passwords even for this local demo environment.

# HTTP Basic Auth credentials used by the three independently authenticated servers.
# Strong, unique values are required; keeping them distinct also exercises auth switching.
ADA_OPENCODE_SERVER_PASSWORD=replace-with-a-unique-ada-demo-password
LINUS_OPENCODE_SERVER_PASSWORD=replace-with-a-unique-linus-demo-password
GRACE_OPENCODE_SERVER_PASSWORD=replace-with-a-unique-grace-demo-password

# Optional model-provider credentials passed unchanged to every server.
# At least one usable provider key is needed for live model responses.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
